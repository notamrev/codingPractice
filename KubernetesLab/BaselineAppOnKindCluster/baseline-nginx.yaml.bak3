apiVersion: apps/v1
kind: Deployment
metadata:
  name: baseline-nginx
  labels:
    app: baseline-nginx
spec:
  replicas: 1
  selector:
    matchLabels:
      app: baseline-nginx
  template:
    metadata:
      labels:
        app: baseline-nginx
    spec:
      containers:
        - name: nginx
          image: nginx:1.27-alpine
          ports:
            - containerPort: 80
          resources:
            requests:
              memory: "32Mi"
              cpu: "50m"
            limits:
              memory: "64Mi"
              cpu: "200m"
---
apiVersion: v1
kind: Service
metadata:
  name: baseline-nginx
spec:
  selector:
    app: baseline-nginx
  ports:
    - port: 80
      targetPort: 80
